<Application x:Class="LevelVault.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="CanvasBrush" Color="#101319"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#191F29"/>
        <SolidColorBrush x:Key="PanelAltBrush" Color="#222B38"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#8B7CFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F2F4FA"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA6B8"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="#394456"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#111720"/>
            <Setter Property="BorderBrush" Value="#394456"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
    </Application.Resources>
</Application>
