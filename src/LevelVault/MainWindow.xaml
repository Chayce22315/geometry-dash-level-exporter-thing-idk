<Window x:Class="LevelVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="levelvault" Height="780" Width="1240" MinHeight="650" MinWidth="980"
        Background="{StaticResource CanvasBrush}" WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="levelvault" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="geometry dash clue finder &amp; recovery workspace" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#282344" CornerRadius="12" Padding="12,7" VerticalAlignment="Center">
                <TextBlock Text="LOCAL-FIRST · EARLY BUILD" Foreground="#C8C0FF" FontSize="11" FontWeight="SemiBold"/>
            </Border>
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="start an investigation" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox x:Name="QueryBox" Height="40" VerticalContentAlignment="Center"
                             ToolTip="enter a level id, name, creator, song id, or any combination"/>
                </StackPanel>
                <Button Grid.Column="1" Content="create investigation" Click="CreateInvestigation_Click" Height="40" Margin="12,26,8,0" Background="#5144A6"/>
                <Button Grid.Column="2" Content="open search set" Click="OpenSearchSet_Click" Height="40" Margin="0,26,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="investigations" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ListBox x:Name="InvestigationList" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextBrush}" SelectionChanged="InvestigationList_SelectionChanged"
                             DisplayMemberPath="Query"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ActiveTitle" Text="no investigation selected" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ActiveSubtitle" Text="create an investigation to begin collecting evidence." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <DockPanel Grid.Row="1" Margin="0,18,0,10">
                        <TextBlock Text="collected clues" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="import .gmd" Click="ImportGmd_Click"/>
                        <Button DockPanel.Dock="Right" Content="add clue" Click="AddClue_Click"/>
                    </DockPanel>
                    <DataGrid x:Name="ClueGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="#111720" Foreground="{StaticResource TextBrush}" RowBackground="#171E28"
                              AlternatingRowBackground="#202938" BorderBrush="#394456" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="type" Binding="{Binding Kind}" Width="100"/>
                            <DataGridTextColumn Header="clue" Binding="{Binding Title}" Width="2*"/>
                            <DataGridTextColumn Header="source" Binding="{Binding SourceUrl}" Width="2*"/>
                            <DataGridTextColumn Header="confidence" Binding="{Binding Confidence}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="3" x:Name="StatusText" Text="clues are stored locally. search links open in your browser; nothing is silently scraped." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" Text="levelvault · original data only · no cloudflare bypass · no fabricated exports" Foreground="#738096" FontSize="11" Margin="2,14,0,0"/>
    </Grid>
</Window>
